@{
    ViewData["Title"] = "NIFTY 50 Live Signal";
}

@section Styles {
    <link rel="stylesheet" href="~/css/nifty.css" asp-append-version="true" />
}

<!-- ═══════════════════════════════════════════════════════════════
     Top header bar
     ═══════════════════════════════════════════════════════════════ -->
<div class="nifty-header">
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <div>
            <span class="nifty-index-label">NIFTY 50</span>
            <span class="nifty-exchange-label">NSE &middot; 1-Min Delayed</span>
        </div>
        <div class="nifty-current-price-block">
            <span id="currentPrice" class="nifty-current-price">Loading&hellip;</span>
            <span id="priceChange" class="nifty-price-change"></span>
        </div>
        <!-- Bias badge -->
        <div id="biasBadge" class="bias-badge bias-neutral">NEUTRAL</div>
        <div class="ms-auto nifty-refresh-info">
            <span class="refresh-dot" id="refreshDot"></span>
            Auto-refresh every 30s &nbsp;|&nbsp; Last updated: <span id="lastUpdated">—</span>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     Stats row
     ═══════════════════════════════════════════════════════════════ -->
<div class="nifty-stats-row">
    <div class="stat-card">
        <span class="stat-label">PDH</span>
        <span class="stat-value stat-danger" id="statPDH">—</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">PDC</span>
        <span class="stat-value stat-warning" id="statPDC">—</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">PDL</span>
        <span class="stat-value stat-success" id="statPDL">—</span>
    </div>
    <div class="stat-divider d-none d-md-block"></div>
    <div class="stat-card">
        <span class="stat-label">Prev Day</span>
        <span class="stat-value" id="statPrevDate">—</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">Today High</span>
        <span class="stat-value stat-info" id="statCDH">—</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">Today Low</span>
        <span class="stat-value stat-info" id="statCDL">—</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">Signals Today</span>
        <span class="stat-value" id="statSignals">0 / 3</span>
    </div>
    <div class="stat-divider d-none d-md-block"></div>
    <div class="stat-card">
        <span class="stat-label">Paper P&amp;L</span>
        <span class="stat-value" id="statPnl">—</span>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     Signal info strip  (bias · state · last event · active signal)
     ═══════════════════════════════════════════════════════════════ -->
<div class="signal-strip">
    <div class="ss-item">
        <span class="ss-label">BIAS</span>
        <span id="ssBias" class="ss-val ss-bias-neutral">NEUTRAL</span>
    </div>
    <div class="ss-sep"></div>
    <div class="ss-item">
        <span class="ss-label">STATE</span>
        <span id="ssState" class="ss-val">Initialising…</span>
    </div>
    <div class="ss-sep"></div>
    <div class="ss-item ss-item-wide">
        <span class="ss-label">LAST EVENT</span>
        <span id="ssLastEvent" class="ss-val">—</span>
        <span id="ssLastEventTime" class="ss-val-sub"></span>
    </div>
    <div class="ss-sep"></div>
    <div class="ss-item">
        <span class="ss-label">NEXT</span>
        <span id="ssNextCond" class="ss-val ss-next">—</span>
    </div>
    <div id="ssSignalWrap" class="ss-sep-signal d-none">
        <div class="ss-sep"></div>
        <div class="ss-item">
            <span id="ssSignalBadge" class="ss-signal-badge">—</span>
            <span id="ssSignalEntry" class="ss-val-sub"></span>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     Error banner
     ═══════════════════════════════════════════════════════════════ -->
<div id="errorBanner" class="nifty-error-banner d-none" role="alert">
    <strong>Data unavailable:</strong> <span id="errorMsg"></span>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     Main two-chart layout: NIFTY 50 (left) | Option Premium (right)
     ═══════════════════════════════════════════════════════════════ -->
<div class="nifty-main-layout">

    <!-- ── Left: NIFTY 50 Candlestick Chart ───────────────────── -->
    <div class="nifty-chart-col">
        <div class="chart-col-header">
            <span class="chart-col-title">NIFTY 50 — Index</span>
            <span class="chart-col-sub">Candlestick · 1-min</span>
        </div>
        <div class="nifty-chart-wrapper">
            <div id="chartLoading" class="chart-loading">
                <div class="spinner-border" style="color:#26a69a;" role="status">
                    <span class="visually-hidden">Loading…</span>
                </div>
                <span style="color:#888;margin-left:12px;">Fetching live market data…</span>
            </div>
            <div id="chartContainer" style="width:100%;height:100%;"></div>
        </div>
        <!-- Legend -->
        <div class="nifty-legend">
            <span class="legend-item"><span class="legend-dot up-dot"></span>Bullish</span>
            <span class="legend-item"><span class="legend-dot down-dot"></span>Bearish</span>
            <span class="legend-item"><span class="legend-line pdh-line-swatch"></span>PDH</span>
            <span class="legend-item"><span class="legend-line pdc-line-swatch"></span>PDC</span>
            <span class="legend-item"><span class="legend-line pdl-line-swatch"></span>PDL</span>
            <span id="orLegend" style="display:none">
                <span class="legend-item"><span class="legend-line orh-line-swatch"></span>ORH</span>
                <span class="legend-item"><span class="legend-line orl-line-swatch"></span>ORL</span>
            </span>
            <span class="legend-item legend-hint">Scroll to zoom &middot; Drag to pan</span>
        </div>
    </div>

    <!-- ── Right: Option Premium Chart ────────────────────────── -->
    <div class="option-chart-col">
        <div class="chart-col-header">
            <span class="chart-col-title" id="optChartTitle">Option Premium</span>
            <span class="chart-col-sub" id="optChartSymbol">Waiting for signal…</span>
        </div>

        <!-- Trade info strip -->
        <div id="optTradeInfo" class="opt-trade-strip" style="display:none;">
            <div class="opt-trade-item">
                <span class="opt-trade-label">Entry ₹</span>
                <span id="optEntry" class="opt-trade-val">—</span>
            </div>
            <div class="opt-vdiv"></div>
            <div class="opt-trade-item">
                <span class="opt-trade-label">Current ₹</span>
                <span id="optCurrent" class="opt-trade-val">—</span>
            </div>
            <div class="opt-vdiv"></div>
            <div class="opt-trade-item">
                <span class="opt-trade-label">P&amp;L (×65)</span>
                <span id="optPnl" class="opt-trade-val">—</span>
            </div>
            <div class="opt-vdiv"></div>
            <div class="opt-trade-item">
                <span class="opt-trade-label">Status</span>
                <span id="optStatus" class="opt-trade-val">—</span>
            </div>
            <div class="opt-vdiv"></div>
            <div class="opt-trade-item opt-trade-item-wide">
                <span id="optSL" class="opt-sl-badge">—</span>
            </div>
        </div>
        <!-- Exit reason + meta info -->
        <div class="opt-meta-strip">
            <span id="optTradeId" class="opt-meta-item"></span>
            <span id="optConfirmTime" class="opt-meta-item"></span>
            <span id="optExitReason" class="opt-meta-item opt-exit-reason" style="display:none;"></span>
        </div>

        <div class="option-chart-wrapper">
            <!-- Placeholder: shown until a signal fires -->
            <div id="optChartPlaceholder" class="opt-placeholder">
                <div class="opt-placeholder-icon">📊</div>
                <div class="opt-placeholder-msg">Waiting for signal…</div>
                <div class="opt-placeholder-sub">
                    When a BUY or SELL fires on the index,<br>
                    the corresponding option premium chart appears here.
                </div>
                <div class="opt-placeholder-rule">
                    <span class="opt-rule-item">🟢 BUY → short PUT (ATM−100)</span>
                    <span class="opt-rule-item">🔴 SELL → short CALL (ATM+100)</span>
                </div>
            </div>
            <!-- TradingView chart: hidden until signal -->
            <div id="optChartContainer" style="width:100%;height:100%;display:none;"></div>
        </div>
    </div>

</div><!-- /nifty-main-layout -->

<!-- ═══════════════════════════════════════════════════════════════
     Paper Trading — Day-wise P&L
     ═══════════════════════════════════════════════════════════════ -->
<div class="pnl-section">
    <div class="pnl-header">
        <div class="pnl-header-left">
            <span class="pnl-title">📋 PAPER TRADING — DAY-WISE P&amp;L</span>
            <span class="pnl-subtitle">Short option strategy · NIFTY lot size 65 · Simulated only</span>
        </div>
        <div class="pnl-header-right">
            <span class="pnl-grand-label">Total P&amp;L</span>
            <span id="pnlGrandTotal" class="pnl-grand-total">₹ —</span>
        </div>
    </div>

    <div id="pnlLoading" class="pnl-loading">
        <div class="spinner-border spinner-border-sm" style="color:#26a69a;"></div>
        <span style="margin-left:8px;color:#8b949e;">Loading trades…</span>
    </div>
    <div id="pnlEmpty" class="pnl-empty d-none">
        No trades yet. Waiting for a signal to fire…
    </div>

    <div id="pnlTableWrap" class="pnl-table-wrap d-none">
        <table class="pnl-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Entry Time</th>
                    <th>Symbol</th>
                    <th>Type</th>
                    <th>NIFTY SL</th>
                    <th class="text-end">Entry ₹</th>
                    <th class="text-end">Exit/Current ₹</th>
                    <th class="text-end">P&amp;L ₹</th>
                    <th>Status</th>
                    <th>Exit Time</th>
                </tr>
            </thead>
            <tbody id="pnlBody"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js"></script>
    <script src="~/js/nifty-chart.js" asp-append-version="true"></script>
}
