{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GrowwApi": {
    "BaseUrl": "https://groww.in/v1/api/charting_service/v2/chart/delayed",
    "IntervalInMinutes": 1,
    "LookbackDays": 3,
    "RegularSessionEndTime": "15:10"
  },
  "TradingStrategy": {
    "SweepTolerancePoints": 5,
    "RequireCloseBackInsideLevel": true,
    "SetupExpiryMinutes": 10,
    "MaxSignalsPerDay": 3,
    "MarketStartTime": "09:15",
    "MarketEndTime": "15:10"
  }
}
